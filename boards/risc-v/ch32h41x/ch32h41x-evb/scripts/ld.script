/* CH32H41x V5F (application core) memory layout - dual-core split.
 *
 *   FLASH  0x08010000..  V5F load image.  The first 64KiB flash block
 *                        (0x08000000) holds the V3F boot loader.
 *   ITCM   0x200A0000    256KiB: interrupt vectors and the fastest code.
 *   DTCM   0x200E0200    128KiB - 512: all runtime data/heap/stack.  The
 *                        first 512 bytes (0x200E0000..0x200E0200) are the
 *                        hardware push/pop stacking area (CSR 0xBC4).
 *   SRAM   0x20105000    492KiB: the rest of the code.  The 20KiB below
 *                        (0x20100000..0x20105000) belongs to the V3F boot
 *                        loader.
 *
 * The flash holds only the load image: ch32h41x_head.S copies
 * .tcm_code into ITCM, .ram_code (+.rodata) into SRAM and .data into
 * DTCM, clears the DTCM bss and then runs everything from RAM.  Only
 * the boot entry (.init/.flashcode) executes from flash.
 */

OUTPUT_ARCH( "riscv" )

ENTRY( _start )

MEMORY
{
  /* V5F load image: linked at the EXECUTABLE zero-wait flash window
   * (0x00010000 = Core_V5F_StartAddr, the V3F wake target).  The
   * 0x08010000 view is the programming alias and cannot execute.
   */

  flash (rx)  : ORIGIN = 0x00010000, LENGTH = 896K

  /* Fast code (vectors + hot path) */

  itcm (rx)   : ORIGIN = 0x200A0000, LENGTH = 256K

  /* Data, heap and stack; skip the 512-byte hw stacking area */

  dtcm (rwx)  : ORIGIN = 0x200E0000 + 512, LENGTH = 128K - 512

  /* Medium-speed code */

  sram (rwx)  : ORIGIN = 0x20105000, LENGTH = 492K
}

SECTIONS
{
  /* Boot entry and the flash -> RAM copy routine, run from flash.
   * The first two instructions at _start force the PC away from the
   * reset fetch address (see ch32h41x_head.S). */

  .init :
  {
    KEEP(*(SORT_NONE(.init)))
    . = ALIGN(4);
  } > flash

  .flashcode :
  {
    . = ALIGN(4);
    KEEP(*(SORT_NONE(.flashcode)))
    . = ALIGN(4);
  } > flash

  /* WCH absolute-address interrupt vector table.  1KiB alignment is a
   * core requirement for the mtvec base in absolute vector mode; the
   * ITCM origin is naturally 1KiB aligned.  _vector_base is defined by
   * ch32h41x_vectors.S so the reference from ch32h41x_head.S pulls the
   * table object out of libarch.a.
   */

  .vector : ALIGN(0x400)
  {
    KEEP(*(.vector))
    . = ALIGN(4);
  } > itcm AT> flash

  _vector_lma = LOADADDR(.vector);
  _vector_vma = ADDR(.vector);
  _vector_end = ADDR(.vector) + SIZEOF(.vector);

  /* Fast code: the whole chip-support layer (drivers, IRQ dispatch,
   * timer ISR) executes from ITCM. */

  .tcm_code :
  {
    . = ALIGN(4);
    _stcm_code = .;
    *(.text .text.*)
    *(.fixup)
    *(.gnu.warning)
    *(.gnu.linkonce.t.*)
    *(.glue_7) *(.glue_7t)
    . = ALIGN(4);
    _etcm_code = .;
  } > itcm AT> flash

  _tcm_code_lma = LOADADDR(.tcm_code);
  _tcm_code_vma = ADDR(.tcm_code);
  _tcm_code_end = ADDR(.tcm_code) + SIZEOF(.tcm_code);

  /* Medium-speed code and constants, run from SRAM */

  .ram_code :
  {
    . = ALIGN(4);
    _sram_code = .;
    *(.kernel .kernel.*)
    *(.rodata .rodata.*)
    *(.rodata1 .rodata1.*)
    *(.sdata2.*)
    *(.gnu.linkonce.r.*)
    . = ALIGN(4);
    _eram_code = .;
  } > sram AT> flash

  _ram_code_lma = LOADADDR(.ram_code);
  _ram_code_vma = ADDR(.ram_code);
  _ram_code_end = ADDR(.ram_code) + SIZEOF(.ram_code);

  .init_array :
  {
    PROVIDE_HIDDEN (__init_array_start = .);
    KEEP (*(SORT_BY_INIT_PRIORITY(.init_array.*) SORT_BY_INIT_PRIORITY(.ctors.*)))
    KEEP (*(.init_array EXCLUDE_FILE (*crtbegin.o *crtbegin?.o *crtend.o *crtend?.o ) .ctors))
    PROVIDE_HIDDEN (__init_array_end = .);
  } > dtcm AT> flash

  .fini_array :
  {
    PROVIDE_HIDDEN (__fini_array_start = .);
    KEEP (*(SORT_BY_INIT_PRIORITY(.fini_array.*) SORT_BY_INIT_PRIORITY(.dtors.*)))
    KEEP (*(.fini_array EXCLUDE_FILE (*crtbegin.o *crtbegin?.o *crtend.o *crtend?.o ) .dtors))
    PROVIDE_HIDDEN (__fini_array_end = .);
  } > dtcm AT> flash

  /* Runtime data: everything below lives in DTCM */

  .data :
  {
    . = ALIGN(4);
    _sdata = .;
    *(.data .data.*)
    *(.gnu.linkonce.d.*)
    . = ALIGN(8);
    PROVIDE(__global_pointer$ = . + 0x800);
    *(.sdata .sdata.*)
    *(.gnu.linkonce.s.*)
    *(.srodata.cst16) *(.srodata.cst8) *(.srodata.cst4) *(.srodata.cst2)
    *(.srodata .srodata.*)
    . = ALIGN(4);
    _edata = .;
  } > dtcm AT> flash

  /* Load/execution address triples consumed by ch32h41x_head.S */

  _initarray_lma = LOADADDR(.init_array);
  _initarray_vma = ADDR(.init_array);
  _initarray_end = ADDR(.init_array) + SIZEOF(.init_array);

  _finiarray_lma = LOADADDR(.fini_array);
  _finiarray_vma = ADDR(.fini_array);
  _finiarray_end = ADDR(.fini_array) + SIZEOF(.fini_array);

  _data_lma = LOADADDR(.data);
  _data_vma = ADDR(.data);
  _data_end = ADDR(.data) + SIZEOF(.data);

  _eronly = LOADADDR(.data);

  .bss (NOLOAD) :
  {
    . = ALIGN(16);
    _sbss = .;
    *(.sbss .sbss.*)
    *(.gnu.linkonce.sb.*)
    *(.bss .bss.*)
    *(.gnu.linkonce.b.*)
    *(COMMON)
    . = ALIGN(16);
    _ebss = .;
  } > dtcm

  /* The idle task reuses the boot stack [_ebss, _ebss + SMP_STACK_SIZE)
   * and the heap begins at g_idle_topstack = _ebss + SMP_STACK_SIZE
   * (see ch32h41x_head.S and ch32h41x_allocateheap.c).  The stack top
   * sits 16 bytes below the DTCM end (BF hot-reboot flags reserve). */

  _eusrstack = ORIGIN(dtcm) + LENGTH(dtcm);

  PROVIDE(_sheap = _ebss);
  PROVIDE(__heap_end = ORIGIN(dtcm) + LENGTH(dtcm));
}
