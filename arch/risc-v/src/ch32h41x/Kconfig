	bool
	default n

config CH32H41X_TIM4_PWM
	bool
	default n

config CH32H41X_TIM5_PWM
	bool
	default n

config CH32H41X_TIM8_PWM
	bool
	default n

config CH32H41X_TIM9_PWM
	bool
	default n

config CH32H41X_TIM10_PWM
	bool
	default n

config CH32H41X_TIM11_PWM
	bool
	default n

config CH32H41X_TIM12_PWM
	bool
	default n

endmenu # CH32H41x Peripheral Support

config CH32H41X_HAVE_ADC1
	bool "ADC1 (internal temperature + Vrefint channels)"
	select CH32H41X_ADC
	---help---
		ADC1 support exposed as /dev/adc0.  The conversion group
		covers the internal temperature-sensor and Vrefint
		channels so the device can be verified without any
		external wiring.  ADC clock comes from the USBHS PLL
		(480MHz/6) following the vendor reference sequence.

config CH32H41X_ADC
	bool
	default n
	select ADC

config CH32H41X_ADC_DMA
	bool "ADC1 DMA scan path (DMA1_CH1, one scan per ANIOC_TRIGGER)"
	default y
	depends on CH32H41X_ADC
	select CH32H41X_DMA
	---help---
		Move the regular group scan with DMA1 channel 1 (DMAMUX
		request 0x78, EVT ADC_DMA sequence).  Falls back to the
		per-channel polled path when the DMA channel is unavailable.

config CH32H41X_DMA
	bool "DMA controller support (DMA1/DMA2 channel manager)"
	default n
	---help---
		Register-level channel manager for the two DMA controllers
		(8 channels each) including the request multiplexer.  Used
		by drivers that transfer through DMA; standalone it only
		provides the allocation/config/poll API.

config CH32H41X_HAVE_CAN1
	bool "CAN1 (bxCAN, loopback capable)"
	select CH32H41X_CAN1
	---help---
		CAN1 support exposed as /dev/can0 at 500kbit/s.  The
		driver starts in loopback mode so the controller can be
		verified without a transceiver; switch to normal mode at
		runtime via CANIOC_SET_CONNMODES.  NOTE: the version-A
		silicon does not implement the hardware filter banks, so
		every frame is delivered to the application (vendor uses
		software filtering in the EVT examples too).

config CH32H41X_CAN1
	bool
	default n
	select CAN

config CH32H41X_HAVE_SPI1
	bool "SPI1 master (PA5 SCK / PA6 MISO / PA7 MOSI, AF5)"
	select CH32H41X_SPI1
	---help---
		SPI1 master exposed as /dev/spi1 (spitool -b 1).  Polled
		full-duplex transfers, 8/16-bit frames, mode 0-3.  Pins
		per the CH32H417DS0 pin table, all AF5.

config CH32H41X_SPI1
	bool
	default n
	select SPI
	select SPI_EXCHANGE

config CH32H41X_HAVE_I2C
	bool "I2C controllers (I2C1/I2C2 master)"
	select CH32H41X_I2C
	---help---
		I2C1 and I2C2 as masters: /dev/i2c0 (PB6/PB7, AF4) and
		/dev/i2c1 (PC0/PC1, AF9).  Requires external pull-ups on
		the bus lines.  The I2C2 hardware-slave responder is
		experimental (see CH32H41X_I2C2_SLAVE) and is OFF by
		default: its TXE level interrupt can storm when a master
		read aborts mid-transfer.
	---help---
		I2C support: I2C1 master on /dev/i2c0 (PB6/PB7, AF4) and
		I2C2 on /dev/i2c1 (PC0/PC1, AF9).  I2C2 additionally runs
		as a hardware slave at address 0x50 so the two controllers
		can exercise each other with two jumpers (PB6-PC0, PB7-PC1).

config CH32H41X_I2C
	bool
	default n
	select I2C
	select I2C_DRIVER

config CH32H41X_HAVE_ONESHOT
	bool "TIM6/TIM7 oneshot timer (/dev/oneshot/0)"
	select CH32H41X_ONESHOT
	---help---
		TIM7 basic timer as the NuttX oneshot lower half
		(/dev/oneshot/0).  100us resolution, maximum delay 6.55s.

config CH32H41X_ONESHOT
	bool
	default n
	select ONESHOT

config CH32H41X_I2C2_SLAVE
	bool "I2C2 hardware-slave responder at 0x50 (experimental)"
	default n
	---help---
		EXPERIMENTAL: makes I2C2 respond as a slave at 0x50 so the
		I2C1 master can self-test against it (jumpers PB6-PC0,
		PB7-PC1 plus pull-ups).  The slave TXE level interrupt can
		storm when a read aborts mid-transfer; the storm breaker in
		the ISR hardware-resets the peripheral as a safety net, but
		leave this OFF unless actively debugging the slave path.
