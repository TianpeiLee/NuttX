include common/Make.defs

# Specify our HEAD assembly file.  This will be linked as the first
# object file, so it will appear at address 0.

HEAD_ASRC = ch32h41x_head.S

CHIP_ASRCS = ch32h41x_vectors.S

# Specify our C code within this directory to be included

CHIP_CSRCS  = ch32h41x_allocateheap.c
CHIP_CSRCS += ch32h41x_clockconfig.c ch32h41x_gpio.c
CHIP_CSRCS += ch32h41x_irq.c ch32h41x_irq_dispatch.c
CHIP_CSRCS += ch32h41x_lowputc.c ch32h41x_start.c
CHIP_CSRCS += ch32h41x_timerisr.c

ifeq ($(CONFIG_CH32H41X_EXTI),y)
CHIP_CSRCS += ch32h41x_exti.c
endif

ifeq ($(CONFIG_CH32H41X_IWDG),y)
CHIP_CSRCS += ch32h41x_iwdg.c
endif

ifeq ($(CONFIG_CH32H41X_TIM),y)
CHIP_CSRCS += ch32h41x_tim.c
endif

ifeq ($(CONFIG_CH32H41X_PWM),y)
CHIP_CSRCS += ch32h41x_pwm.c
endif

ifeq ($(CONFIG_CH32H41X_TIM2_CAPTURE),y)
CHIP_CSRCS += ch32h41x_capture.c
endif

ifeq ($(CONFIG_CH32H41X_USART1),y)
CHIP_CSRCS += ch32h41x_serial.c
else ifeq ($(CONFIG_CH32H41X_USART2),y)
CHIP_CSRCS += ch32h41x_serial.c
else ifeq ($(CONFIG_CH32H41X_USART3),y)
CHIP_CSRCS += ch32h41x_serial.c
else ifeq ($(CONFIG_CH32H41X_USART4),y)
CHIP_CSRCS += ch32h41x_serial.c
else ifeq ($(CONFIG_CH32H41X_USART5),y)
CHIP_CSRCS += ch32h41x_serial.c
else ifeq ($(CONFIG_CH32H41X_USART6),y)
CHIP_CSRCS += ch32h41x_serial.c
else ifeq ($(CONFIG_CH32H41X_USART7),y)
CHIP_CSRCS += ch32h41x_serial.c
else ifeq ($(CONFIG_CH32H41X_USART8),y)
CHIP_CSRCS += ch32h41x_serial.c
endif

ifeq ($(CONFIG_CH32H41X_DMA),y)
CHIP_CSRCS += ch32h41x_dma.c
endif

ifeq ($(CONFIG_CH32H41X_ADC),y)
CHIP_CSRCS += ch32h41x_adc.c
endif

ifeq ($(CONFIG_CH32H41X_CAN1),y)
CHIP_CSRCS += ch32h41x_can.c
endif

ifeq ($(CONFIG_CH32H41X_SPI1),y)
CHIP_CSRCS += ch32h41x_spi.c
endif

ifeq ($(CONFIG_CH32H41X_I2C),y)
CHIP_CSRCS += ch32h41x_i2c.c
endif

ifeq ($(CONFIG_CH32H41X_ONESHOT),y)
CHIP_CSRCS += ch32h41x_oneshot.c
endif
